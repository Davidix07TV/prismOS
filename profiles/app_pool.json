      "subsystem": "nessuno"
    },
    "Android_Pkg": {
      "runtime": "Waydroid + LineageOS 16.0 (Android 9) x86 ricostruita senza SSE4.2",
      "install_mechanism": "waydroid app install <apk>",
      "pin_mechanism": "PinnedLauncherApps tramite package name",
      "isa_constraint": "ABI x86 obbligatoria: libhoudini/libndk_translation richiedono SSE4.2 e sono esclusi",
      "subsystem": "prismos-waydroid-container.service"
    },
    "Windows_Pkg": {
      "runtime": "Wine staging + ottimizzazioni Proton (wined3d, fsync)",
      "install_mechanism": "prismos-wine-run <installer.exe|installer.msi>",
      "pin_mechanism": "scorciatoia .desktop generata nel prefix, esposta dal launcher Ash",
      "isa_constraint": "PE compilato per x86-64-v1 (SSE2) o i386; binari x86-64-v2/v3 rifiutati",
      "subsystem": "prismos-wine-session@1000.service"
    }
  },
