# =============================================================================
#  legacy-cpu.config - vincoli ISA per CPU senza SSE4.2 (Intel Arrandale Pentium)
# -----------------------------------------------------------------------------
#  Il kernel ChromeOS upstream abilita ottimizzazioni che su Arrandale sono
#  inutili (nessuna CPU Intel di prima generazione ha AVX, AES-NI o SHA-NI) e
#  in alcuni casi dannose: le routine alternative occupano icache e il
#  dispatcher delle CPU feature costa cicli ad ogni avvio.
#
#  Nota: il kernel usa il rilevamento CPUID a runtime per le istruzioni SIMD,
#  quindi queste opzioni non sono strettamente necessarie alla correttezza;
#  servono a ridurre il footprint e a evitare che un modulo venga compilato con
#  un floor ISA superiore a SSE4.1.
# =============================================================================

# Scheduler dimensionato per 2 core / 2 thread.
CONFIG_NR_CPUS=4
CONFIG_MAXSMP=n
CONFIG_SCHED_SMT=y
CONFIG_SCHED_MC=y
CONFIG_SCHED_MC_PRIO=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_SCHED_HRTICK=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_HZ_300=y
CONFIG_HZ=300
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y

# Nessuna funzionalita' che presupponga AVX/AES-NI/SHA-NI.
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_AES_TI=y
CONFIG_CRYPTO_SHA1_SSSE3=y
CONFIG_CRYPTO_CRC32C_INTEL=y
CONFIG_CRYPTO_CRC32_PCLMUL=n
CONFIG_CRYPTO_GHASH_CLMUL_NI_INTEL=n
CONFIG_CRYPTO_CRCT10DIF_PCLMUL=n
CONFIG_CRYPTO_POLYVAL_CLMUL_NI=n
CONFIG_CRYPTO_SHA256_SSSE3=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZO=y
CONFIG_CRYPTO_DEFLATE=y
CONFIG_CRYPTO_AEAD=y

# Memcpy/memset ottimizzate per la microarchitettura Westmere/Arrandale.
CONFIG_X86_USE_PPRO_CHECKSUM=y
CONFIG_X86_INTERNODE_CACHE_SHIFT=6
CONFIG_X86_L1_CACHE_SHIFT=6
CONFIG_X86_P6_NOP=y
CONFIG_MICROCODE=y
CONFIG_MICROCODE_INTEL=y

# Le SKU Pentium di Arrandale non hanno VT-x ne' VT-d: il supporto IOMMU resta
# compilato (necessario per crosvm/Crostini sull'hardware piu' recente che usa
# la stessa immagine) ma non viene attivato di default.
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=n
CONFIG_INTEL_IOMMU_SVM=n
CONFIG_IRQ_REMAP=n
CONFIG_X86_VSMP=n
CONFIG_HYPERV=n
CONFIG_KVM_GUEST=n
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_SPINLOCKS=y

# Lockup detector disattivato: un interrupt al secondo per core impedisce al
# package di entrare in C4 e consuma batteria sui portatili legacy.
CONFIG_HARDLOCKUP_DETECTOR=n
CONFIG_SOFTLOCKUP_DETECTOR=n
CONFIG_DETECT_HUNG_TASK=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=n
# Il driver watchdog hardware del PCH (ICH) resta attivo: su queste macchine
# e' l'unico meccanismo di recovery dopo un hard hang.
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_WATCHDOG_NOWAYOUT=n
CONFIG_SOFT_WATCHDOG=n
CONFIG_I6300ESB_WDT=n
CONFIG_ITCO_WDT=y
