# =============================================================================
#  slim.config - opzioni per prismOS Slim (macchine con meno di 2 GB di RAM)
# -----------------------------------------------------------------------------
#  Riduzione del footprint del kernel e gestione aggressiva della memoria.
#  Questi frammenti sono attivi anche nelle altre edizioni (il costo e' nullo),
#  ma i loro effetti si misurano davvero solo con 1-2 GB di RAM.
# =============================================================================

# --- zram: swap compressa in RAM ---------------------------------------------------
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZRAM_MEMORY_TRACKING=y
CONFIG_ZSMALLOC=y
CONFIG_ZPOOL=y
CONFIG_Z3FOLD=y
CONFIG_ZBUD=y
CONFIG_ZSMALLOC_STAT=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_LZO_COMPRESS=y
CONFIG_LZ4_COMPRESS=y
CONFIG_842_COMPRESS=y
CONFIG_ZSTD_COMPRESS=y

# --- Pressure Stall Information: usato da earlyoom e dal reaper di idle -------------
CONFIG_PSI=y
CONFIG_PSI_DEFAULT_DISABLED=n

# --- Memory control group: tetti per Waydroid/Wine -------------------------------------
CONFIG_MEMCG=y
CONFIG_MEMCG_KMEM=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_SLUB=y
CONFIG_SLUB_CPU_PARTIAL=y
CONFIG_SLUB_DEBUG=y
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_MISC=n
CONFIG_FRAME_POINTER=n
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=n
CONFIG_BUG=y
CONFIG_ELF_CORE=y
CONFIG_BASE_FULL=y
CONFIG_FUTEX=y

# --- Riduzione dei moduli e delle funzionalita' non necessarie ---------------------------
CONFIG_MODULES=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_COMPRESS_ALL=y
# TRIM_UNUSED_KSYMS resta disattivato: eliminerebbe i simboli richiesti dai
# moduli out-of-tree (ashmem_linux) e dai binari precompilati di ChromeOS,
# che non sono visibili all'analisi dei simboli del kernel.
CONFIG_TRIM_UNUSED_KSYMS=n
CONFIG_MODULE_SIG=n
CONFIG_MODULE_FORCE_UNLOAD=y

# --- Filesystem minimi ---------------------------------------------------------------------
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y

# --- Debugging ridotto ---------------------------------------------------------------------
# BPF_SYSCALL e PERF_EVENTS NON possono essere disattivati: il sandbox di
# Chromium (seccomp-bpf), minijail e crash_reporter li richiedono.
# Si riducono invece i tracer, che sono la vera fonte di overhead.
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_DYNAMIC_DEBUG=n
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=n
CONFIG_STACK_TRACER=n
CONFIG_DYNAMIC_FTRACE=n
CONFIG_FUNCTION_GRAPH_TRACER=n
CONFIG_KPROBES=n
CONFIG_KPROBE_EVENTS=n
CONFIG_UPROBE_EVENTS=n
CONFIG_PERF_EVENTS=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_DEFAULT_ON=n
CONFIG_PROFILING=y
CONFIG_KCOV=n
CONFIG_KASAN=n
CONFIG_DEBUG_FS=y
