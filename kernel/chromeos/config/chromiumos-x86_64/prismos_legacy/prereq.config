# =============================================================================
#  prereq.config - prerequisiti Kconfig per rendere visibili le opzioni dei
#  frammenti successivi (android.config, wine.config, slim.config).
# =============================================================================
CONFIG_ANDROID=y
CONFIG_STAGING=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CPUSETS=y
CONFIG_PROC_PID_CPUSET=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_BRIDGE=y
CONFIG_VETH=y
CONFIG_TUN=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_BINFMT_MISC=y
CONFIG_EXPERT=y
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_PSI=y
