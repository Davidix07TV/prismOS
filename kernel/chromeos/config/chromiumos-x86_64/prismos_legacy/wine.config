# =============================================================================
#  wine.config - supporto kernel per l'esecuzione di PE Windows via Wine/Proton
# -----------------------------------------------------------------------------
#  binfmt_misc permette di aprire un file .exe direttamente dal file manager:
#  il kernel lo riconosce dal magic "MZ" e lo passa a
#  /usr/bin/prismos-slim-launcher (registrato in /proc/sys/fs/binfmt_misc).
#  Questo e' il meccanismo che rende possibile il doppio clic su un .exe,
#  analogamente a quanto avviene per gli script con shebang.
# =============================================================================

CONFIG_BINFMT_MISC=y
CONFIG_BINFMT_ELF=y
CONFIG_COMPAT_BINFMT_ELF=y
CONFIG_COREDUMP=y
CONFIG_ELF_CORE=y

# --- fsync / esync (patch Proton) --------------------------------------------------
# fsync usa un file anonimo e futex per la sincronizzazione dei thread Win32:
# riduce drasticamente i context switch su 2 core rispetto allo spinlock di
# wineserver. Richiede FUTEX, EPOLL e i real-time futex.
CONFIG_FUTEX=y
CONFIG_FUTEX_PI=y
CONFIG_RT_MUTEXES=y
CONFIG_RT_GROUP_SCHED=y
CONFIG_POSIX_TIMERS=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT_NOTIFIERS=y

# --- Memoria: i prefissi Wine mappano grandi aree anonime --------------------------
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_ZSWAP_ZPOOL_DEFAULT_Z3FOLD=y
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSMALLOC=y
CONFIG_ZPOOL=y
CONFIG_Z3FOLD=y
CONFIG_ZBUD=y
CONFIG_SWAP=y

# --- I/O: i giochi e i gestionali Win32 usano I/O asincrono -------------------------
CONFIG_IO_URING=y
CONFIG_AIO=y
CONFIG_BLK_DEV_NVME=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_SCSI=y
CONFIG_SCSI_LOWLEVEL=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# --- Input: controller di gioco -------------------------------------------------------
CONFIG_JOYSTICK_XPAD=y
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_HIDRAW=y
CONFIG_UHID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_INPUT_FF_MEMLESS=y

# --- Audio: WASAPI/ALSA emulation -----------------------------------------------------
CONFIG_SND_HRTIMER=y
CONFIG_SND_SEQ_HRTIMER_DEFAULT=y
CONFIG_SND_DYNAMIC=y
CONFIG_SND_PCM_XRUN_DEBUG=n

# --- Reti: Winsock e NetBIOS -----------------------------------------------------------
CONFIG_PACKET=y
CONFIG_PACKET_DIAG=y
CONFIG_UNIX=y
CONFIG_UNIX_DIAG=y
CONFIG_INET_DIAG=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_NET_IPGRE_DEMUX=y
CONFIG_PPTP=y
CONFIG_PPPOE=y
