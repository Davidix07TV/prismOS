# =============================================================================
#  android.config - supporto kernel per Waydroid (LineageOS 16.0 / Android 9)
# -----------------------------------------------------------------------------
#  Sostituisce integralmente il supporto ARC/ARC++/ARCVM di Google, che richiede
#  un container Android compilato con SSE4.2 e su Intel Pentium P6100 entra in
#  un loop infinito di riavvio.
#
#  Waydroid richiede:
#    * binder IPC (preferibilmente via binderfs)
#    * ashmem (kernel < 5.18) oppure il fallback memfd
#    * namespaces completi e cgroup v2 delegabili
#    * netfilter/NAT per il bridge waydroid0
# =============================================================================

# --- Binder --------------------------------------------------------------------
# CONFIG_ANDROID_BINDER_IPC e' un bool: non puo' essere modularizzato.
# binderfs e' il meccanismo moderno: monta un filesystem in /dev/binderfs e crea
# i nodi binder/hwbinder/vndbinder su richiesta, evitando dispositivi statici.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES=""
CONFIG_ANDROID_BINDER_IPC_SELFTEST=n

# --- Ashmem ----------------------------------------------------------------------
# Rimosso dal mainline in 5.18 (sostituito da memfd). Sul kernel 6.1 di ChromeOS
# il simbolo esiste solo come modulo out-of-tree (ashmem_linux); si lascia
# disattivato e Waydroid usa il fallback memfd, abilitato dalle prop
# persist.waydroid.ashmem=fallback.
CONFIG_ASHMEM=n
CONFIG_MEMFD_CREATE=y
CONFIG_SHMEM=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_AIO=y
CONFIG_IO_URING=y

# --- Namespaces e cgroup -----------------------------------------------------------
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_TIME_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FAVOR_DYNMODS=y
CONFIG_CGROUP_MISC=y
CONFIG_CGROUP_RDMA=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_SOCK_CGROUP_DATA=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_NETPRIO_CGROUP=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_RT_GROUP_SCHED=y
CONFIG_BLK_DEV_THROTTLING=y

# --- Filesystem e device richiesti da Android 9 ------------------------------------------
CONFIG_DEVMEM=y
CONFIG_DEVKMEM=n
CONFIG_UNIX98_PTYS=y
CONFIG_LEGACY_PTYS=n
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y
CONFIG_EPOLL=y

# --- Grafica: buffer sharing fra container e compositore Ash --------------------------------
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=64
CONFIG_SYNC_FILE=y
CONFIG_SW_SYNC=y
CONFIG_UDMABUF=y
CONFIG_DRM_GEM_SHMEM_HELPER=y

# --- Audio e input passthrough ---------------------------------------------------------
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_MISC=y
CONFIG_SOUND_OSS_CORE=y
CONFIG_SND_PCM_OSS=y
CONFIG_SND_TIMER=y
CONFIG_SND_RAWMIDI=y

# --- Rete del container -------------------------------------------------------------------
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_TARGET_CLASSIFY=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP6_NF_IPTABLES=y

# --- Loop e overlay per le immagini system.img / vendor.img -----------------------------------
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=8
CONFIG_BLK_DEV_DM=y
CONFIG_DM_INIT=y
