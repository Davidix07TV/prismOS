  "ShowHomeButton": true,
  "RestoreOnStartup": 1,
  "DefaultBrowserSettingEnabled": false,

  "SafeBrowsingProtectionLevel": 2,
  "SafeBrowsingExtendedReportingEnabled": true,
  "PasswordManagerEnabled": true,
  "AutofillAddressEnabled": true,
