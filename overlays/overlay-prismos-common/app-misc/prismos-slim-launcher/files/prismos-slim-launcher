cmd_run_package() {
  local pkg="${1:-}"
  [[ -n "${pkg}" ]] || die 1 "uso: ${PROG_NAME} run-package <package.name>"
  local rc=0
  waydroid_available || die 3 "Waydroid non disponibile"
  acquire_lock waydroid || rc=$?
  [[ ${rc} -eq 0 ]] || exit "${rc}"
  waydroid_container_start
  waydroid_session_start
  ACTIVE_SUBSYSTEM="waydroid"
  log_info "lancio diretto del package ${pkg}"
  waydroid app launch "${pkg}" >/dev/null 2>&1 || die 1 "waydroid app launch ${pkg} fallito"
  wait_for_android_app "${pkg}" || rc=$?
  return "${rc}"
}

# =============================================================================
# MAIN
# =============================================================================
main() {
  local argv0="${1:-}"
  [[ -n "${argv0}" ]] || { cmd_help; exit 1; }

  case "${argv0}" in
    -h|--help|help)         cmd_help; exit 0 ;;
    -V|--version|version)   echo "${PROG_NAME} ${PROG_VERSION}"; exit 0 ;;
    status)                 shift; load_config; cmd_status; exit $? ;;
    stop-all|stopall)       shift; load_config; cmd_stop_all; exit $? ;;
    gc)                     shift; load_config; cmd_gc "${1:-30}"; exit $? ;;
    doctor)                 shift; load_config; cmd_doctor; exit $? ;;
    run)                    shift; argv0="${1:-}" ;;
    run-package)            shift; load_config; cmd_run_package "${1:-}"; exit $? ;;
  esac

  [[ -n "${argv0}" ]] || { cmd_help; exit 1; }
  shift || true

  load_config

  # Override da ambiente.
  [[ -n "${PRISMOS_WAYDROID_IMAGE:-}" ]] && PRISMOS_SLIM_WAYDROID_IMAGE_DIR="${PRISMOS_WAYDROID_IMAGE}"
  local prefix_name="${PRISMOS_WINE_PREFIX:-${PRISMOS_SLIM_WINE_DEFAULT_PREFIX}}"

  local target="${argv0}"
  [[ -e "${target}" ]] || die 2 "file inesistente: ${target}"
  target="$(realpath -- "${target}" 2>/dev/null || echo "${target}")"
  ensure_readable "${target}"

  mkdir -p "${RUN_DIR}" 2>/dev/null || true
  chmod 1777 "${RUN_DIR}" 2>/dev/null || true

  local kind="${PRISMOS_SLIM_FORCE_KIND:-}"
  if [[ -z "${kind}" ]]; then
    kind="$(detect_file_kind "${target}")"
    if [[ "${kind}" == "unknown" ]]; then
      # Fallback sull'estensione (utile quando `od`/`unzip` non sono presenti).
      case "${target,,}" in
        *.apk) kind="apk" ;;
        *.exe) kind="exe32" ;;
        *.msi) kind="msi" ;;
        *)     kind="unknown" ;;
      esac
    fi
  fi

  log_info "file=${target} tipo=${kind} utente=${USER:-$(id -un)} euid=${EUID} RAM_libera=$(human_mb "$(mem_available_kb)")"

  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  local rc=0
  case "${kind}" in
    apk)
      run_apk "${target}" || rc=$?
      ;;
    exe32|exe64)
      PRISMOS_SLIM_WINE_DEFAULT_PREFIX="${prefix_name}" run_windows_binary "${target}" "${kind}" || rc=$?
      ;;
    msi)
      PRISMOS_SLIM_WINE_DEFAULT_PREFIX="${prefix_name}" run_windows_binary "${target}" "msi" || rc=$?
      ;;
    unknown)
      die 2 "tipo di file non riconosciuto (attesi .apk, .exe o .msi): ${target}"
      ;;
  esac

  if [[ "${PRISMOS_SLIM_NO_TEARDOWN:-0}" == "1" ]]; then
    log_warn "PRISMOS_SLIM_NO_TEARDOWN=1: il sottosistema resta attivo"
    ACTIVE_SUBSYSTEM=""
    ACTIVE_UNIT=""
    ACTIVE_CONTAINER_UNIT=""
  fi

  if (( rc == 0 )); then
    log_info "operazione completata correttamente"
  else
    log_warn "operazione conclusa con codice ${rc}"
  fi
  exit "${rc}"
}

main "$@"
