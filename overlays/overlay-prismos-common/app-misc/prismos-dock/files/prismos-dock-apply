PROG = "prismos-dock-apply"
VERSION = "1.0.0"

SHELF_CONF_DEFAULT = "/usr/share/prismos/ash-shelf.conf"
SHELF_JSON_SKEL = "/etc/skel/.config/chromiumos/shelf.json"
SHELF_JSON_USER = "/home/chronos/.config/chromiumos/shelf.json"
POLICY_DIR = "/etc/chromium/policies/managed"
POLICY_FILE = os.path.join(POLICY_DIR, "zz-prismos-dock.json")
ICON_THEME_ROOT = "/usr/share/icons/prismOS-Squircle"
GTK_SETTINGS = "/etc/xdg/gtk-3.0/settings.ini"
APP_POOL = "/usr/share/prismos/app_pool.json"

ALIGNMENTS = ("Bottom", "Left", "Right")
AUTOHIDE = ("Always", "Never", "OnFullScreen")


def log(msg: str) -> None:
    """Scrive su stderr e, se disponibile, sul journal."""
    line = f"{PROG}: {msg}"
    print(line, file=sys.stderr, flush=True)
    if shutil.which("logger"):
        try:
            subprocess.run(
                ["logger", "-t", "prismos-dock", "-p", "user.info", "--", line],
                check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
        except OSError:
            pass


def warn(msg: str) -> None:
    line = f"{PROG}: AVVISO {msg}"
    print(line, file=sys.stderr, flush=True)
    if shutil.which("logger"):
        try:
            subprocess.run(
                ["logger", "-t", "prismos-dock", "-p", "user.warning", "--", line],
                check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
        except OSError:
            pass


# ---------------------------------------------------------------------------
# Configurazione
# ---------------------------------------------------------------------------
def load_shelf_conf(path: str, overrides: Dict[str, Any]) -> Dict[str, Any]:
    """Legge il file INI della Dock e applica gli override da riga di comando."""
    cp = configparser.ConfigParser(interpolation=None, strict=False)
    cp.optionxform = str  # conserva il case delle chiavi
    read = cp.read(path, encoding="utf-8")
    if not read:
        warn(f"{path} non trovato: uso i default integrati")

    conf: Dict[str, Any] = {
        "alignment": "Bottom",
        "autohide": "Always",
        "centered": True,
        "icon_size": 48,
        "icon_spacing": 8,
        "squircle_radius": 0.28,
        "squircle_exponent": 5.0,
        "pin_max": 8,
        "launcher_button_position": "center",
        "launcher_accelerator": "super+space",
        "hotseat_collapsible": True,
        "animation_duration_ms": 180,
        "background_blur": True,
        "background_opacity": 0.86,
        "dock_offset_bottom": 0,
        "show_window_indicators": True,
        "magnification_on_hover": False,
        "magnification_factor": 1.0,
    }
    if cp.has_section("dock"):
        for key, raw in cp.items("dock"):
            conf[key] = _coerce(raw)

    for key, value in overrides.items():
        if value is not None:
            conf[key] = value

    if conf["alignment"] not in ALIGNMENTS:
        warn(f"alignment '{conf['alignment']}' non valido: imposto 'Bottom'")
        conf["alignment"] = "Bottom"
    if conf["autohide"] not in AUTOHIDE:
        warn(f"autohide '{conf['autohide']}' non valido: imposto 'Always'")
        conf["autohide"] = "Always"
    try:
        conf["icon_size"] = max(24, min(96, int(conf["icon_size"])))
        conf["pin_max"] = max(1, min(24, int(conf["pin_max"])))
        conf["squircle_radius"] = max(0.0, min(0.5, float(conf["squircle_radius"])))
        conf["squircle_exponent"] = max(2.0, min(10.0, float(conf["squircle_exponent"])))
    except (TypeError, ValueError) as exc:
        warn(f"valore numerico non valido in ash-shelf.conf: {exc}")

    return conf


def _coerce(raw: str) -> Any:
    value = raw.strip()
    low = value.lower()
    if low in ("true", "yes", "on", "1"):
        return True
    if low in ("false", "no", "off", "0"):
        return False
    try:
        return int(value)
    except ValueError:
        pass
    try:
        return float(value)
    except ValueError:
        pass
    return value


def load_shelf_json(paths: Sequence[str]) -> List[Dict[str, Any]]:
    """Carica la lista delle app bloccate sulla Dock dal primo file disponibile."""
    for path in paths:
        if not os.path.isfile(path):
            continue
        try:
            with open(path, "r", encoding="utf-8") as fh:
                data = json.load(fh)
        except (OSError, json.JSONDecodeError) as exc:
            warn(f"{path} non leggibile o non valido: {exc}")
            continue
        items = data.get("pinned_apps") if isinstance(data, dict) else data
        if isinstance(items, list):
            log(f"shelf.json caricato da {path} ({len(items)} voci)")
            return [it for it in items if isinstance(it, dict)]
    warn("nessuno shelf.json valido trovato: la Dock usera' i default di ChromeOS")
    return []


def load_app_pool(path: str = APP_POOL) -> Dict[str, Dict[str, Any]]:
    """Indicizza profiles/app_pool.json (copiato nell'immagine) per id."""
    if not os.path.isfile(path):
        return {}
    try:
        with open(path, "r", encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, json.JSONDecodeError) as exc:
        warn(f"app_pool.json non valido: {exc}")
        return {}
    index: Dict[str, Dict[str, Any]] = {}
    for app in data.get("applications", []):
        app_id = app.get("id")
        if isinstance(app_id, str):
            index[app_id] = app
    return index


# ---------------------------------------------------------------------------
# 1. Policy di device
# ---------------------------------------------------------------------------
def write_policy(conf: Dict[str, Any], shelf_items: List[Dict[str, Any]],
                 pool: Dict[str, Dict[str, Any]], path: str = POLICY_FILE) -> bool:
    """Scrive /etc/chromium/policies/managed/zz-prismos-dock.json."""
    pinned: List[str] = []
    force_list: List[Dict[str, Any]] = []
    seen: set = set()

    for item in shelf_items:
        app_id = str(item.get("id", "")).strip()
        entry = pool.get(app_id, item)
        launch_url = str(entry.get("launch_url") or item.get("launch_url") or "").strip()
        name = str(entry.get("name") or item.get("name") or app_id).strip()
        key = launch_url or app_id
        if not key or key in seen:
            continue
        seen.add(key)

        app_type = str(entry.get("type") or item.get("type") or "Web_App")
        if app_type == "Web_App" and launch_url:
            # PinnedLauncherApps accetta le web app tramite l'URL usato in
            # WebAppInstallForceList: i due elenchi devono restare coerenti.
            pinned.append(launch_url)
            force_entry: Dict[str, Any] = {"url": launch_url}
            create_url = str(entry.get("install_url") or launch_url).strip()
            if create_url:
                force_entry["create_url"] = create_url
            scope = str(entry.get("scope") or "").strip()
            if scope:
                force_entry["scope"] = scope
            force_list.append(force_entry)
        elif app_type == "Android_Pkg":
            package = str(entry.get("android_package") or "").strip()
            if package:
                pinned.append(package)
        elif app_type == "Windows_Pkg":
            # Gli eseguibili Windows non sono "app" di Ash: vengono esposti come
            # scorciatoia tramite prismos-wine-runner e non pinnati direttamente.
            continue
        elif launch_url:
            pinned.append(launch_url)

    if conf.get("pin_max"):
        pinned = pinned[: int(conf["pin_max"])]

    policy: Dict[str, Any] = {
        "ShelfAlignment": str(conf["alignment"]),
        "ShelfAutoHideBehavior": str(conf["autohide"]),
        "PinnedLauncherApps": pinned,
    }
    if force_list:
        policy["WebAppInstallForceList"] = force_list

    if not pinned:
        # PinnedLauncherApps vuota significa "nessuna app bloccata": si omette la
        # chiave per lasciare all'utente la lista predefinita di ChromeOS.
        policy.pop("PinnedLauncherApps", None)

    try:
        os.makedirs(os.path.dirname(path), mode=0o755, exist_ok=True)
        tmp = f"{path}.tmp.{os.getpid()}"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(policy, fh, indent=2, ensure_ascii=False, sort_keys=False)
            fh.write("\n")
        os.replace(tmp, path)
        os.chmod(path, 0o644)
    except OSError as exc:
        warn(f"impossibile scrivere {path}: {exc}")
        return False

    log(f"policy Dock scritta in {path}: alignment={policy['ShelfAlignment']} "
        f"autohide={policy['ShelfAutoHideBehavior']} pin={len(policy.get('PinnedLauncherApps', []))} "
        f"pwa={len(policy.get('WebAppInstallForceList', []))}")
    return True


# ---------------------------------------------------------------------------
# 2. Pref Ash (dispositivi non gestiti)
# ---------------------------------------------------------------------------
def chrome_running() -> bool:
    """True se il processo chrome della sessione e' vivo (Local State e' in uso)."""
    for pid_dir in glob.glob("/proc/[0-9]*"):
        try:
            with open(os.path.join(pid_dir, "comm"), "r", encoding="utf-8") as fh:
                if fh.read().strip() == "chrome":
                    return True
        except OSError:
            continue
    return False


def patch_local_state(conf: Dict[str, Any]) -> int:
    """Scrive i pref della Shelf nei profili utente esistenti. Ritorna il numero
    di profili aggiornati. Operazione sicura solo a Chrome spento."""
    if chrome_running():
        warn("chrome e' in esecuzione: i pref Ash non vengono modificati "
             "(la policy di device resta comunque applicata)")
        return 0

    alignment_pref = str(conf["alignment"]).lower()
    updated = 0
    for state_path in glob.glob("/home/chronos/u-*/Local State"):
        try:
            with open(state_path, "r", encoding="utf-8") as fh:
                state = json.load(fh)
        except (OSError, json.JSONDecodeError) as exc:
            warn(f"{state_path} non leggibile: {exc}")
            continue

        changed = _set_pref(state, "ash.shelf.alignment", alignment_pref)
        changed |= _set_pref(state, "ash.shelf.autohide_behavior", str(conf["autohide"]))
        changed |= _set_pref(state, "ash.shelf.icon_size", int(conf["icon_size"]))
        changed |= _set_pref(state, "ash.shelf.centered", bool(conf.get("centered", True)))
        if not changed:
            continue

        backup = f"{state_path}.prismos-backup"
        if not os.path.exists(backup):
            try:
                shutil.copy2(state_path, backup)
            except OSError as exc:
                warn(f"backup di {state_path} fallito: {exc}")

        tmp = f"{state_path}.tmp"
        try:
            with open(tmp, "w", encoding="utf-8") as fh:
                json.dump(state, fh, ensure_ascii=False)
            os.replace(tmp, state_path)
            updated += 1
            log(f"pref Ash aggiornati in {state_path}")
        except OSError as exc:
            warn(f"scrittura di {state_path} fallita: {exc}")
            try:
                os.unlink(tmp)
            except OSError:
                pass

    if updated == 0:
        log("nessun profilo utente presente: i pref Ash saranno impostati al "
            "primo login (o dalla policy di device)")
    return updated


def _set_pref(root: Dict[str, Any], dotted_key: str, value: Any) -> bool:
    """Imposta una chiave puntata ('a.b.c') in un dizionario annidato."""
    parts = dotted_key.split(".")
    node = root
    for part in parts[:-1]:
        nxt = node.get(part)
        if not isinstance(nxt, dict):
            nxt = {}
            node[part] = nxt
        node = nxt
    leaf = parts[-1]
    if node.get(leaf) == value:
        return False
    node[leaf] = value
    return True


# ---------------------------------------------------------------------------
# 3. shelf.json dell'utente (copia dallo skeleton)
# ---------------------------------------------------------------------------
def propagate_shelf_json() -> None:
    if not os.path.isfile(SHELF_JSON_SKEL):
        return
    for target in (SHELF_JSON_USER,):
        directory = os.path.dirname(target)
        try:
            os.makedirs(directory, mode=0o755, exist_ok=True)
            if not os.path.exists(target):
                shutil.copy2(SHELF_JSON_SKEL, target)
                _chown_chronos(target)
                _chown_chronos(directory)
                log(f"shelf.json propagato in {target}")
        except OSError as exc:
            warn(f"propagazione di {target} fallita: {exc}")


def _chown_chronos(path: str) -> None:
    try:
        import pwd
        info = pwd.getpwnam("chronos")
        os.chown(path, info.pw_uid, info.pw_gid)
    except (ImportError, KeyError, OSError):
        pass


# ---------------------------------------------------------------------------
# 4. Tema iconografico squircle
# ---------------------------------------------------------------------------
def squircle_path(size: int, radius_ratio: float, exponent: float) -> str:
    """Tracciato SVG di una superellisse (squircle) normalizzata su `size`.

    La forma macOS non e' un rettangolo con angoli arrotondati: e' una
    superellisse |x|^n + |y|^n = r^n con n ~ 5, che produce la curvatura
    continua ("continuous corner") tipica delle icone di Big Sur/Sonoma.
    Il tracciato e' approssimato con curve di Bezier cubiche: per n=5 l'errore
    massimo rispetto alla superellisse esatta e' < 0.4 px su 128 px.
    """
    size = float(size)
    r = max(1.0, min(0.5, float(radius_ratio)) * size)
    n = max(2.0, float(exponent))
    half = size / 2.0
    k = _squircle_control_factor(n)

    def pt(x: float, y: float) -> str:
        return f"{half + x:.2f} {half + y:.2f}"

    a = r
    b = r
    c = k * r
    segments = [
        # da (a,0) a (0,a) passando per il primo ottante
        (pt(a, 0), pt(a, c), pt(c, a), pt(0, a)),
        (pt(0, a), pt(-c, a), pt(-a, c), pt(-a, 0)),
        (pt(-a, 0), pt(-a, -c), pt(-c, -a), pt(0, -a)),
        (pt(0, -a), pt(c, -a), pt(a, -c), pt(a, 0)),
    ]
    d = f"M {pt(a, 0)} "
    for _, c1, c2, end in segments:
        d += f"C {c1}, {c2}, {end} "
    d += "Z"
    return d


def _squircle_control_factor(n: float) -> float:
    """Fattore di controllo Bezier che approssima la superellisse di esponente n.

    Per n=2 (cerchio) il fattore classico e' 0.5523; per n->inf (quadrato)
    tende a 1. L'interpolazione usa la funzione gamma di Euler tramite la
    relazione esatta del quarto di superellisse campionata a 45 gradi.
    """
    if n <= 2.0:
        return 0.5523
    # Punto della superellisse a 45 gradi: (r*2^(-1/n), r*2^(-1/n))
    t = 2.0 ** (-1.0 / n)
    # Il fattore cresce linearmente fra il caso circolare e quello quadratico.
    return min(1.0, 0.5523 + (1.0 - 0.5523) * ((t - 2.0 ** -0.5) / (1.0 - 2.0 ** -0.5)))


def build_icon_theme(conf: Dict[str, Any], shelf_items: List[Dict[str, Any]],
                     pool: Dict[str, Dict[str, Any]]) -> int:
    """Genera il tema icone squircle. Ritorna il numero di icone prodotte."""
    scalable = os.path.join(ICON_THEME_ROOT, "apps", "scalable")
    try:
        os.makedirs(scalable, mode=0o755, exist_ok=True)
    except OSError as exc:
        warn(f"impossibile creare {scalable}: {exc}")
        return 0

    size = 128
    mask = squircle_path(size, conf["squircle_radius"], conf["squircle_exponent"])
    count = 0

    wanted: List[Dict[str, Any]] = []
    seen = set()
    for item in shelf_items:
        app_id = str(item.get("id", "")).strip()
        if not app_id or app_id in seen:
            continue
        seen.add(app_id)
        entry = dict(pool.get(app_id, {}))
        entry.update({k: v for k, v in item.items() if v is not None})
        wanted.append(entry)
    # Icone di sistema sempre presenti.
    for sys_icon in ("prismos-waydroid", "prismos-wine", "prismos-slim-launcher",
                     "prismos-launcher", "prismos-files", "prismos-settings"):
        if sys_icon not in seen:
            seen.add(sys_icon)
            wanted.append({"id": sys_icon, "name": sys_icon.replace("-", " ").title(),
                           "color": "#4A5568"})

    for entry in wanted:
        app_id = str(entry.get("id"))
        name = str(entry.get("name") or app_id)
        color = str(entry.get("color") or entry.get("icon_color") or "#5B6CFF")
        glyph = str(entry.get("glyph") or _initials(name))
        svg = _render_squircle_svg(size, mask, color, glyph, name)
        out = os.path.join(scalable, f"{app_id}.svg")
        try:
            with open(out, "w", encoding="utf-8") as fh:
                fh.write(svg)
            os.chmod(out, 0o644)
            count += 1
        except OSError as exc:
            warn(f"scrittura di {out} fallita: {exc}")

    _write_index_theme(conf)
    _register_gtk_theme()
    log(f"tema icone prismOS-Squircle generato: {count} icone in {scalable}")
    return count


def _initials(name: str) -> str:
    words = re.split(r"[\s\-_.]+", name.strip())
    words = [w for w in words if w]
    if not words:
        return "?"
    if len(words) == 1:
        return words[0][:2].upper()
    return (words[0][0] + words[1][0]).upper()


def _render_squircle_svg(size: int, mask: str, color: str, glyph: str, title: str) -> str:
    """SVG dell'icona: sfondo squircle + gradiente + glifo centrato."""
    glyph = (glyph or "?").replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    title = title.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    light = _mix(color, "#FFFFFF", 0.28)
    dark = _mix(color, "#000000", 0.22)
    font_size = int(size * (0.42 if len(glyph) > 1 else 0.52))
    radius_id = f"sq{abs(hash(mask)) % 10**8:08d}"
    return f"""<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="{size}" height="{size}" viewBox="0 0 {size} {size}">
  <title>{title}</title>
  <defs>
    <clipPath id="{radius_id}"><path d="{mask}"/></clipPath>
    <linearGradient id="g{radius_id}" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="{light}"/>
      <stop offset="1" stop-color="{dark}"/>
    </linearGradient>
    <radialGradient id="s{radius_id}" cx="0.5" cy="0.18" r="0.85">
      <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.28"/>
      <stop offset="1" stop-color="#FFFFFF" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <g clip-path="url(#{radius_id})">
    <rect width="{size}" height="{size}" fill="url(#g{radius_id})"/>
    <rect width="{size}" height="{size}" fill="url(#s{radius_id})"/>
    <text x="{size / 2:.1f}" y="{size / 2:.1f}" text-anchor="middle"
          dominant-baseline="central" font-family="DejaVu Sans, Roboto, sans-serif"
          font-size="{font_size}" font-weight="600" fill="#FFFFFF"
          style="paint-order:stroke">{glyph}</text>
  </g>
  <path d="{mask}" fill="none" stroke="#000000" stroke-opacity="0.10" stroke-width="1.5"/>
</svg>
"""


def _mix(hex_color: str, other: str, amount: float) -> str:
    """Miscela due colori esadecimali; ritorna il primo se non e' parsabile."""
    try:
        c = _hex_to_rgb(hex_color)
        o = _hex_to_rgb(other)
    except ValueError:
        return hex_color
    mixed = tuple(int(round(c[i] + (o[i] - c[i]) * amount)) for i in range(3))
    return "#{:02X}{:02X}{:02X}".format(*mixed)


def _hex_to_rgb(value: str) -> Sequence[int]:
    value = value.strip().lstrip("#")
    if len(value) == 3:
        value = "".join(ch * 2 for ch in value)
    if len(value) != 6 or not re.fullmatch(r"[0-9a-fA-F]{6}", value):
        raise ValueError(f"colore esadecimale non valido: {value}")
    return (int(value[0:2], 16), int(value[2:4], 16), int(value[4:6], 16))


def _write_index_theme(conf: Dict[str, Any]) -> None:
    content = f"""[Icon Theme]
Name=prismOS Squircle
Comment=Maschera iconografica squircle (superellisse n={conf['squircle_exponent']}) in stile macOS
Inherits=hicolor,Adwaita
Directories=apps/scalable

[apps/scalable]
Size={int(conf['icon_size'])}
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications
"""
    path = os.path.join(ICON_THEME_ROOT, "index.theme")
    try:
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(content)
        os.chmod(path, 0o644)
    except OSError as exc:
        warn(f"impossibile scrivere {path}: {exc}")


def _register_gtk_theme() -> None:
    """Imposta prismOS-Squircle come tema icone per le app GTK (Wine, Crostini)."""
    directory = os.path.dirname(GTK_SETTINGS)
    try:
        os.makedirs(directory, mode=0o755, exist_ok=True)
    except OSError as exc:
        warn(f"impossibile creare {directory}: {exc}")
        return

    cp = configparser.ConfigParser(interpolation=None, strict=False)
    cp.optionxform = str
    cp.read(GTK_SETTINGS, encoding="utf-8")
    if not cp.has_section("Settings"):
        cp.add_section("Settings")
    cp.set("Settings", "gtk-icon-theme-name", "prismOS-Squircle")
    cp.set("Settings", "gtk-theme-name", "Adwaita")
    cp.set("Settings", "gtk-cursor-theme-name", "Adwaita")
    try:
        with open(GTK_SETTINGS, "w", encoding="utf-8") as fh:
            cp.write(fh)
        os.chmod(GTK_SETTINGS, 0o644)
        log(f"tema icone registrato in {GTK_SETTINGS}")
    except OSError as exc:
        warn(f"scrittura di {GTK_SETTINGS} fallita: {exc}")

    if shutil.which("gtk-update-icon-cache"):
        try:
            subprocess.run(["gtk-update-icon-cache", "-q", "-f", "-t", ICON_THEME_ROOT],
                           check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass


# ---------------------------------------------------------------------------
# 5. Verifica
# ---------------------------------------------------------------------------
def verify(path: str = POLICY_FILE) -> bool:
    if not os.path.isfile(path):
        warn(f"{path} assente")
        return False
    try:
        with open(path, "r", encoding="utf-8") as fh:
            policy = json.load(fh)
    except (OSError, json.JSONDecodeError) as exc:
        warn(f"{path} non e' JSON valido: {exc}")
        return False

    ok = True
    if policy.get("ShelfAlignment") != "Bottom":
        warn("ShelfAlignment non e' 'Bottom': la Dock non sara' in basso")
        ok = False
    if policy.get("ShelfAutoHideBehavior") != "Always":
        warn("ShelfAutoHideBehavior non e' 'Always': autohide non forzato")
        ok = False
    mode = os.stat(path).st_mode
    if mode & (stat.S_IWGRP | stat.S_IWOTH):
        warn(f"{path} e' scrivibile da gruppo/altri (mode {oct(mode & 0o777)})")
        ok = False
    if ok:
        log(f"verifica di {path} superata")
    return ok


def parse_args(argv: Optional[List[str]] = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="Applica la Dock/Shelf macOS-like di prismOS alla sessione Ash.",
    )
    parser.add_argument("--conf", default=SHELF_CONF_DEFAULT,
                        help=f"file INI della Dock (default: {SHELF_CONF_DEFAULT})")
    parser.add_argument("--shelf-json", action="append", default=None,
                        help="percorso di shelf.json (ripetibile; default: skel + utente)")
    parser.add_argument("--alignment", choices=ALIGNMENTS, default=None,
                        help="posizione della Shelf (default: Bottom)")
    parser.add_argument("--autohide", choices=AUTOHIDE, default=None,
                        help="comportamento di autohide (default: Always)")
    parser.add_argument("--icon-size", type=int, default=None,
                        help="dimensione icona in px (24-96)")
    parser.add_argument("--squircle", type=float, default=None,
                        help="rapporto di arrotondamento squircle (0.0-0.5)")
    parser.add_argument("--pin-max", type=int, default=None,
                        help="numero massimo di icone bloccate sulla Dock")
    parser.add_argument("--policy-only", action="store_true",
                        help="scrive solo la policy di device")
    parser.add_argument("--prefs-only", action="store_true",
                        help="scrive solo i pref Ash nei profili esistenti")
    parser.add_argument("--icons-only", action="store_true",
                        help="genera solo il tema icone squircle")
    parser.add_argument("--verify", action="store_true",
                        help="verifica la policy installata ed esce")
    parser.add_argument("--version", action="version", version=f"{PROG} {VERSION}")
    return parser.parse_args(argv)


def main(argv: Optional[List[str]] = None) -> int:
    args = parse_args(argv)

    if args.verify:
        return 0 if verify() else 1

    started = time.time()
    overrides: Dict[str, Any] = {
        "alignment": args.alignment,
        "autohide": args.autohide,
        "icon_size": args.icon_size,
        "squircle_radius": args.squircle,
        "pin_max": args.pin_max,
    }
    conf = load_shelf_conf(args.conf, overrides)
    shelf_paths = args.shelf_json or [SHELF_JSON_SKEL, SHELF_JSON_USER]
    shelf_items = load_shelf_json(shelf_paths)
    pool = load_app_pool()

    log(f"edizione Dock: alignment={conf['alignment']} autohide={conf['autohide']} "
        f"centered={conf['centered']} icon_size={conf['icon_size']} "
        f"squircle_radius={conf['squircle_radius']} pin_max={conf['pin_max']}")

    rc = 0
    if not args.prefs_only and not args.icons_only:
        if not write_policy(conf, shelf_items, pool):
            rc = 1
    if not args.policy_only and not args.icons_only:
        patch_local_state(conf)
        propagate_shelf_json()
    if not args.policy_only and not args.prefs_only:
        if build_icon_theme(conf, shelf_items, pool) == 0:
            warn("nessuna icona squircle generata")

    if rc == 0 and not verify():
        rc = 1

    log(f"operazione completata in {time.time() - started:.2f}s (rc={rc})")
    return rc


if __name__ == "__main__":
    sys.exit(main())
