#!/usr/bin/env bash
# =============================================================================
#  prismos-dock  -  wrapper utente della Dock/Shelf macOS-like di prismOS
# -----------------------------------------------------------------------------
#  Percorso di installazione : /usr/bin/prismos-dock          (0755 root:root)
#  Pacchetto                 : app-misc/prismos-dock
#  Helper di sistema         : /usr/libexec/prismos/prismos-dock-apply (python3)
#  Configurazione            : /usr/share/prismos/ash-shelf.conf
#  Policy generata           : /etc/chromium/policies/managed/zz-prismos-dock.json
#  Log                       : journal (ident=prismos-dock)
#
#  SCOPO
#  -----
#  prismos-dock-apply e' un helper di sistema eseguito da
#  prismos-dock-apply.service prima di ui.target; non e' pensato per l'uso
#  interattivo. Questo wrapper e' invece il comando che l'utente (o un
#  amministratore) invoca per:
#
#    apply    riapplicare la configurazione della Dock senza riavviare
#    verify   verificare la policy installata (codice di uscita 0/1)
#    show     mostrare la configurazione effettiva e la sua provenienza
#    status   stato dell'unita' systemd, della policy e del tema di icone
#    policy   rigenerare soltanto la policy di device
#    prefs    riscrivere soltanto i pref ash.shelf.* nei profili esistenti
#    icons    rigenerare soltanto il tema di icone squircle
#
#  Ogni sotto-comando accetta le sostituzioni puntuali --alignment, --autohide,
#  --icon-size, --squircle e --pin-max, che hanno precedenza sui valori del file
#  di configurazione.
#
#  PRIVILEGI
#  ---------
#  La scrittura della policy in /etc/chromium/policies/managed richiede root.
#  Se il wrapper non e' eseguito da root e sudo e' disponibile, l'helper viene
#  invocato con sudo; in assenza di sudo l'operazione viene rifiutata con una
#  spiegazione, senza tentare scritture parziali.
# =============================================================================

set -Eeuo pipefail
shopt -s inherit_errexit

readonly PROG="prismos-dock"
readonly VERSION="1.0.0"
readonly HELPER="/usr/libexec/prismos/prismos-dock-apply"
readonly SHELF_CONF="${PRISMOS_SHELF_CONF:-/usr/share/prismos/ash-shelf.conf}"
readonly POLICY_FILE="/etc/chromium/policies/managed/zz-prismos-dock.json"
readonly POLICY_DIR="/etc/chromium/policies/managed"
readonly ICON_THEME="/usr/share/icons/prismOS-Squircle"
readonly UNIT_NAME="prismos-dock-apply.service"
readonly LOG_TAG="prismos-dock"
readonly EDITION_CONF="/etc/prismos/edition.conf"

# Sostituzioni puntuali (vuote = usa il file di configurazione).
OVR_ALIGNMENT=""
OVR_AUTOHIDE=""
OVR_ICON_SIZE=""
OVR_SQUIRCLE=""
OVR_PIN_MAX=""
SHELF_JSON_ARG=""
VERBOSE=0
FORCE_SUDO=0

# -----------------------------------------------------------------------------
#  Output
# -----------------------------------------------------------------------------
if [[ -t 1 ]]; then
	readonly C_RED=$'\033[31m' C_GREEN=$'\033[32m' C_YELLOW=$'\033[33m'
	readonly C_BLUE=$'\033[36m' C_BOLD=$'\033[1m' C_RESET=$'\033[0m'
else
	readonly C_RED="" C_GREEN="" C_YELLOW="" C_BLUE="" C_BOLD="" C_RESET=""
fi

log()  { printf '%s%s:%s %s\n' "${C_BLUE}" "${PROG}" "${C_RESET}" "$*" >&2; }
vlog() { (( VERBOSE )) && log "$@" || true; }
ok()   { printf '%s  OK%s   %s\n' "${C_GREEN}" "${C_RESET}" "$*" >&2; }
warn() { printf '%s  AVVISO%s %s\n' "${C_YELLOW}" "${C_RESET}" "$*" >&2; }
err()  { printf '%s  ERRORE%s %s\n' "${C_RED}" "${C_RESET}" "$*" >&2; }

die() {
	local code="$1"; shift
	err "$*"
	journal_send "err" "$*" || true
	exit "${code}"
}

# Copia nel journal quando disponibile: il wrapper e' usato anche da script di
# provisioning e il log su disco non e' garantito in tutte le edizioni.
journal_send() {
	local prio="$1"; shift
	if command -v logger >/dev/null 2>&1; then
		logger -t "${LOG_TAG}" -p "user.${prio}" -- "${PROG}: $*" 2>/dev/null || true
	fi
	return 0
}

usage() {
	cat <<EOF
${C_BOLD}${PROG}${C_RESET} ${VERSION} - Dock/Shelf macOS-like di prismOS

USO
  ${PROG} <comando> [opzioni]

COMANDI
  apply        riapplica la configurazione (policy + pref Ash + icone)
  verify       verifica la policy installata; esce 0 se conforme, 1 altrimenti
  show         mostra la configurazione effettiva e la provenienza di ogni valore
  status       stato dell'unita' systemd, della policy, del tema di icone
  policy       rigenera soltanto ${POLICY_FILE##*/}
  prefs        riscrive soltanto i pref ash.shelf.* nei profili esistenti
  icons        rigenera soltanto il tema di icone squircle
  help         questo messaggio
  version      versione del wrapper e dell'helper

OPZIONI
  --alignment Bottom|Left|Right   posizione della Shelf (default: Bottom)
  --autohide Always|Never|OnFullScreen
                                  comportamento di autohide (default: Always)
  --icon-size N                   dimensione icona in px (24-96)
  --squircle F                    arrotondamento squircle (0.00-0.50)
  --pin-max N                     massimo numero di icone bloccate
  --shelf-json PATH               shelf.json da usare (ripetibile)
  --sudo                          forza l'uso di sudo anche se non necessario
  --verbose                       tracciamento delle operazioni
  --version, --help               informazioni

FILE
  ${SHELF_CONF}      configurazione dichiarativa (INI, sezione [dock])
  ${POLICY_FILE}
                     policy di device generata (prefisso zz-: ultima letta)
  ${ICON_THEME}/     tema di icone squircle (superellisse n=5)
  ${EDITION_CONF}            parametri di edizione usati da prismos-firstboot

ESEMPI
  ${PROG} show
  ${PROG} verify
  ${PROG} apply --icon-size 40 --pin-max 6
  ${PROG} policy --alignment Bottom --autohide Always
  ${PROG} icons
EOF
}

# -----------------------------------------------------------------------------
#  Analisi degli argomenti
# -----------------------------------------------------------------------------
parse_args() {
	COMMAND=""
	local passthrough=()

	while (( $# > 0 )); do
		case "$1" in
			apply|verify|show|status|policy|prefs|icons)
				COMMAND="$1"; shift ;;
			help|-h|--help)
				usage; exit 0 ;;
			version|-v|--version)
				COMMAND="version"; shift ;;
			--alignment)
				OVR_ALIGNMENT="${2:-}"; shift 2 ;;
			--alignment=*)
				OVR_ALIGNMENT="${1#*=}"; shift ;;
			--autohide)
				OVR_AUTOHIDE="${2:-}"; shift 2 ;;
			--autohide=*)
				OVR_AUTOHIDE="${1#*=}"; shift ;;
			--icon-size)
				OVR_ICON_SIZE="${2:-}"; shift 2 ;;
			--icon-size=*)
				OVR_ICON_SIZE="${1#*=}"; shift ;;
			--squircle)
				OVR_SQUIRCLE="${2:-}"; shift 2 ;;
			--squircle=*)
				OVR_SQUIRCLE="${1#*=}"; shift ;;
			--pin-max)
				OVR_PIN_MAX="${2:-}"; shift 2 ;;
			--pin-max=*)
				OVR_PIN_MAX="${1#*=}"; shift ;;
			--shelf-json)
				SHELF_JSON_ARG="${2:-}"; shift 2 ;;
			--shelf-json=*)
				SHELF_JSON_ARG="${1#*=}"; shift ;;
			--sudo)
				FORCE_SUDO=1; shift ;;
			--verbose)
				VERBOSE=1; shift ;;
			--)
				shift; while (( $# > 0 )); do passthrough+=("$1"); shift; done ;;
			*)
				err "argomento non riconosciuto: $1"
				usage >&2
				exit 2 ;;
		esac
	done

	EXTRA_ARGS=("${passthrough[@]+"${passthrough[@]}"}")

	[[ -n "${COMMAND}" ]] || { usage >&2; exit 2; }
	validate_overrides
}

validate_overrides() {
	case "${OVR_ALIGNMENT}" in
		""|Bottom|Left|Right) ;;
		*) die 2 "--alignment accetta solo Bottom, Left o Right (ricevuto: ${OVR_ALIGNMENT})" ;;
	esac
	case "${OVR_AUTOHIDE}" in
		""|Always|Never|OnFullScreen) ;;
		*) die 2 "--autohide accetta solo Always, Never o OnFullScreen (ricevuto: ${OVR_AUTOHIDE})" ;;
	esac
	if [[ -n "${OVR_ICON_SIZE}" ]]; then
		[[ "${OVR_ICON_SIZE}" =~ ^[0-9]+$ ]] || die 2 "--icon-size richiede un intero (ricevuto: ${OVR_ICON_SIZE})"
		if (( OVR_ICON_SIZE < 24 || OVR_ICON_SIZE > 96 )); then
			die 2 "--icon-size deve essere compreso fra 24 e 96 (ricevuto: ${OVR_ICON_SIZE})"
		fi
	fi
	if [[ -n "${OVR_SQUIRCLE}" ]]; then
		[[ "${OVR_SQUIRCLE}" =~ ^0?\.?[0-9]+$ ]] || die 2 "--squircle richiede un decimale 0.00-0.50 (ricevuto: ${OVR_SQUIRCLE})"
		if awk -v v="${OVR_SQUIRCLE}" 'BEGIN { exit !(v >= 0 && v <= 0.5) }'; then
			:
		else
			die 2 "--squircle deve essere compreso fra 0.00 e 0.50 (ricevuto: ${OVR_SQUIRCLE})"
		fi
	fi
	if [[ -n "${OVR_PIN_MAX}" ]]; then
		[[ "${OVR_PIN_MAX}" =~ ^[0-9]+$ ]] || die 2 "--pin-max richiede un intero (ricevuto: ${OVR_PIN_MAX})"
		if (( OVR_PIN_MAX < 1 || OVR_PIN_MAX > 24 )); then
			die 2 "--pin-max deve essere compreso fra 1 e 24 (ricevuto: ${OVR_PIN_MAX})"
		fi
	fi
	if [[ -n "${SHELF_JSON_ARG}" && ! -f "${SHELF_JSON_ARG}" ]]; then
		die 2 "shelf.json non trovato: ${SHELF_JSON_ARG}"
	fi
}

# -----------------------------------------------------------------------------
#  Lettura della configurazione INI (sezione [dock])
# -----------------------------------------------------------------------------
conf_get() {
	local key="$1" line value
	[[ -r "${SHELF_CONF}" ]] || return 1
	while IFS= read -r line || [[ -n "${line}" ]]; do
		line="${line%%#*}"
		line="${line#"${line%%[![:space:]]*}"}"
		[[ "${line}" == "${key}"*=* ]] || continue
		value="${line#*=}"
		value="${value%"${value##*[![:space:]]}"}"
		printf '%s\n' "${value}"
		return 0
	done < "${SHELF_CONF}"
	return 1
}

effective_value() {
	# $1 = sostituzione puntuale, $2 = chiave INI, $3 = default
	if [[ -n "$1" ]]; then
		printf '%s\n' "$1"
	elif [[ -r "${SHELF_CONF}" ]]; then
		local v=""
		v="$(conf_get "$2" || true)"
		if [[ -n "${v}" ]]; then
			printf '%s\n' "${v}"
			return 0
		fi
		printf '%s\n' "$3"
	else
		printf '%s\n' "$3"
	fi
}

# -----------------------------------------------------------------------------
#  Invocazione dell'helper
# -----------------------------------------------------------------------------
helper_command() {
	# Stampa, una per riga, le parole del comando da eseguire. Le redirezioni non
	# possono comparire qui: finirebbero fra gli elementi dell'array.
	if [[ "$(id -u)" -eq 0 ]]; then
		printf '%s\n' "${HELPER}"
		return 0
	fi

	if (( FORCE_SUDO )) || [[ ! -w "${POLICY_DIR}" ]]; then
		if command -v sudo >/dev/null 2>&1; then
			# -n evita attese interattive quando il wrapper e' invocato da una
			# unita' systemd o da uno script; se le credenziali non sono in cache
			# si ripiega su sudo normale, che puo' chiedere la password.
			if sudo -n true >/dev/null 2>&1; then
				printf '%s\n' "sudo" "-n" "${HELPER}"
			else
				printf '%s\n' "sudo" "${HELPER}"
			fi
			return 0
		fi
		warn "nessun privilegio di root e sudo assente: la policy in ${POLICY_DIR} non sara' scrivibile"
	fi

	printf '%s\n' "${HELPER}"
}

build_helper_args() {
	local -a args=()
	args+=(--conf "${SHELF_CONF}")

	case "$1" in
		policy) args+=(--policy-only) ;;
		prefs)  args+=(--prefs-only) ;;
		icons)  args+=(--icons-only) ;;
		verify) args+=(--verify) ;;
	esac

	[[ -n "${OVR_ALIGNMENT}" ]]  && args+=(--alignment "${OVR_ALIGNMENT}")
	[[ -n "${OVR_AUTOHIDE}" ]]   && args+=(--autohide "${OVR_AUTOHIDE}")
	[[ -n "${OVR_ICON_SIZE}" ]]  && args+=(--icon-size "${OVR_ICON_SIZE}")
	[[ -n "${OVR_SQUIRCLE}" ]]   && args+=(--squircle "${OVR_SQUIRCLE}")
	[[ -n "${OVR_PIN_MAX}" ]]    && args+=(--pin-max "${OVR_PIN_MAX}")
	[[ -n "${SHELF_JSON_ARG}" ]] && args+=(--shelf-json "${SHELF_JSON_ARG}")
	if (( ${#EXTRA_ARGS[@]} > 0 )); then
		args+=("${EXTRA_ARGS[@]}")
	fi
	printf '%s\n' "${args[@]}"
}

run_helper() {
	local mode="$1"
	[[ -x "${HELPER}" ]] || die 3 "helper non eseguibile: ${HELPER} (reinstallare app-misc/prismos-dock)"
	command -v python3 >/dev/null 2>&1 || die 3 "python3 non disponibile: l'helper della Dock non puo' essere eseguito"

	local -a cmd=() args=()
	while IFS= read -r line; do [[ -n "${line}" ]] && cmd+=("${line}"); done < <(helper_command)
	while IFS= read -r line; do [[ -n "${line}" ]] && args+=("${line}"); done < <(build_helper_args "${mode}")

	vlog "esecuzione: ${cmd[*]} ${args[*]}"
	local rc=0
	"${cmd[@]}" "${args[@]}" || rc=$?
	journal_send "info" "${mode}: helper terminato con rc=${rc}" || true
	return "${rc}"
}

# -----------------------------------------------------------------------------
#  Comandi
# -----------------------------------------------------------------------------
cmd_apply() {
	local mode="${1:-apply}"
	log "applicazione della configurazione della Dock (modalita': ${mode})"
	local rc=0
	run_helper "${mode}" || rc=$?
	if (( rc == 0 )); then
		ok "policy, preferenze Ash e icone aggiornate"
		log "la modifica e' visibile al prossimo avvio di Chrome; per applicarla subito:"
		log "  systemctl restart ui.target     (oppure riavviare la sessione)"
	else
		err "l'helper ha segnalato errori (rc=${rc})"
	fi
	return "${rc}"
}

cmd_verify() {
	local rc=0
	run_helper "verify" || rc=$?
	if (( rc == 0 )); then
		ok "policy della Dock conforme: ${POLICY_FILE}"
	else
		err "policy della Dock non conforme o assente"
	fi
	return "${rc}"
}

cmd_show() {
	local alignment autohide icon_size squircle exponent pin_max centered blur opacity
	alignment="$(effective_value "${OVR_ALIGNMENT}" alignment Bottom)"
	autohide="$(effective_value "${OVR_AUTOHIDE}" autohide Always)"
	icon_size="$(effective_value "${OVR_ICON_SIZE}" icon_size 48)"
	squircle="$(effective_value "${OVR_SQUIRCLE}" squircle_radius 0.28)"
	exponent="$(effective_value "" squircle_exponent 5.0)"
	pin_max="$(effective_value "${OVR_PIN_MAX}" pin_max 8)"
	centered="$(effective_value "" centered True)"
	blur="$(effective_value "" background_blur True)"
	opacity="$(effective_value "" background_opacity 0.86)"

	printf '\n%s%s - configurazione effettiva%s\n' "${C_BOLD}" "${PROG}" "${C_RESET}"
	printf '  %-22s %s\n' "allineamento" "${alignment}"
	printf '  %-22s %s\n' "autohide" "${autohide}"
	printf '  %-22s %s\n' "icone centrate" "${centered}"
	printf '  %-22s %s px\n' "dimensione icone" "${icon_size}"
	printf '  %-22s %s\n' "raggio squircle" "${squircle}"
	printf '  %-22s %s\n' "esponente superellisse" "${exponent}"
	printf '  %-22s %s\n' "pin massimi" "${pin_max}"
	printf '  %-22s %s\n' "blur di sfondo" "${blur}"
	printf '  %-22s %s\n' "opacita' di sfondo" "${opacity}"

	local source="${SHELF_CONF}"
	if [[ -r "${source}" ]]; then
		printf '\n  provenienza          : %s\n' "${source}"
	else
		printf '\n  provenienza          : %s (assente, usati i default)\n' "${source}"
	fi
	local -a overrides=()
	[[ -n "${OVR_ALIGNMENT}" ]] && overrides+=("alignment=${OVR_ALIGNMENT}")
	[[ -n "${OVR_AUTOHIDE}" ]] && overrides+=("autohide=${OVR_AUTOHIDE}")
	[[ -n "${OVR_ICON_SIZE}" ]] && overrides+=("icon-size=${OVR_ICON_SIZE}")
	[[ -n "${OVR_SQUIRCLE}" ]] && overrides+=("squircle=${OVR_SQUIRCLE}")
	[[ -n "${OVR_PIN_MAX}" ]] && overrides+=("pin-max=${OVR_PIN_MAX}")
	[[ -n "${SHELF_JSON_ARG}" ]] && overrides+=("shelf-json=${SHELF_JSON_ARG}")
	if (( ${#overrides[@]} > 0 )); then
		printf '  sostituzioni attive  : %s\n' "${overrides[*]}"
	fi

	if [[ -r "${EDITION_CONF}" ]]; then
		local edition_id="" shelf_size="" shelf_pin=""
		edition_id="$(sed -nE 's/^[[:space:]]*EDITION_ID="?([^"]*)"?.*/\1/p' "${EDITION_CONF}" | head -1)"
		shelf_size="$(sed -nE 's/^[[:space:]]*SHELF_ICON_SIZE="?([^"]*)"?.*/\1/p' "${EDITION_CONF}" | head -1)"
		shelf_pin="$(sed -nE 's/^[[:space:]]*SHELF_PIN_MAX="?([^"]*)"?.*/\1/p' "${EDITION_CONF}" | head -1)"
		printf '  edizione             : %s%s%s\n' "${edition_id:-non dichiarata}" \
			"${shelf_size:+ (icon_size=${shelf_size})}" "${shelf_pin:+ (pin_max=${shelf_pin})}"
	fi

	printf '\n  policy installata    : '
	if [[ -r "${POLICY_FILE}" ]]; then
		printf '%s\n' "${POLICY_FILE}"
		if command -v python3 >/dev/null 2>&1; then
			python3 - "${POLICY_FILE}" <<'PY' 2>/dev/null || true
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as fh:
        data = json.load(fh)
except Exception:
    print("    (policy non leggibile come JSON)")
    sys.exit(0)
for key in ("ShelfAlignment", "ShelfAutoHideBehavior"):
    if key in data:
        print(f"    {key} = {data[key]}")
pinned = data.get("PinnedLauncherApps") or []
print(f"    PinnedLauncherApps = {len(pinned)} voci")
forced = data.get("WebAppInstallForceList") or []
print(f"    WebAppInstallForceList = {len(forced)} voci")
for entry in pinned[:10]:
    print(f"      - {entry}")
PY
		fi
	else
		printf 'assente (eseguire %s apply)\n' "${PROG}"
	fi

	printf '\n  tema di icone        : '
	if [[ -d "${ICON_THEME}/apps/scalable" ]]; then
		local count=0
		while IFS= read -r _; do (( ++count )) || true; done < <(find "${ICON_THEME}/apps/scalable" -maxdepth 1 -name '*.svg' -type f 2>/dev/null)
		printf '%s (%s SVG)\n' "${ICON_THEME}" "${count}"
	else
		printf 'assente\n'
	fi
	printf '\n'
	return 0
}

cmd_status() {
	printf '\n%s%s - stato%s\n' "${C_BOLD}" "${PROG}" "${C_RESET}"
	local rc=0

	if command -v systemctl >/dev/null 2>&1 && [[ -d /run/systemd/system ]]; then
		local state=""
		state="$(systemctl is-enabled "${UNIT_NAME}" 2>/dev/null || true)"
		local active=""
		active="$(systemctl is-active "${UNIT_NAME}" 2>/dev/null || true)"
		printf '  %-22s %s / %s\n' "unita' systemd" "${state:-non abilitata}" "${active:-inattiva}"
		if [[ "${active}" != "active" && "${active}" != "inactive" ]]; then
			rc=1
		fi
	else
		printf '  %-22s %s\n' "unita' systemd" "systemd non disponibile"
	fi

	if [[ -r "${POLICY_FILE}" ]]; then
		ok "policy presente: ${POLICY_FILE}"
	else
		err "policy assente: ${POLICY_FILE}"
		rc=1
	fi

	if [[ -r "${SHELF_CONF}" ]]; then
		ok "configurazione presente: ${SHELF_CONF}"
	else
		err "configurazione assente: ${SHELF_CONF}"
		rc=1
	fi

	if [[ -x "${HELPER}" ]]; then
		ok "helper eseguibile: ${HELPER}"
	else
		err "helper non eseguibile: ${HELPER}"
		rc=1
	fi

	if [[ -d "${ICON_THEME}/apps/scalable" ]]; then
		local count=0
		while IFS= read -r _; do (( ++count )) || true; done < <(find "${ICON_THEME}/apps/scalable" -maxdepth 1 -name '*.svg' -type f 2>/dev/null)
		if (( count > 0 )); then
			ok "tema di icone presente: ${count} SVG"
		else
			err "tema di icone vuoto: ${ICON_THEME}/apps/scalable"
			rc=1
		fi
	else
		err "tema di icone assente: ${ICON_THEME}"
		rc=1
	fi

	local shelf_json="/etc/skel/.config/chromiumos/shelf.json"
	if [[ -r "${shelf_json}" ]]; then
		ok "shelf.json di skel presente"
	else
		warn "shelf.json assente in /etc/skel: i nuovi profili useranno i default di Ash"
	fi

	if command -v systemctl >/dev/null 2>&1 && [[ -d /run/systemd/system ]]; then
		if systemctl is-active --quiet prismos-accelerator-daemon.service 2>/dev/null; then
			ok "daemon degli acceleratori attivo (super+space)"
		else
			warn "daemon degli acceleratori non attivo: super+space non funzionera'"
		fi
	fi

	printf '\n'
	return "${rc}"
}

cmd_version() {
	printf '%s %s\n' "${PROG}" "${VERSION}"
	if [[ -x "${HELPER}" ]] && command -v python3 >/dev/null 2>&1; then
		"${HELPER}" --version 2>/dev/null || warn "versione dell'helper non disponibile"
	else
		warn "helper non eseguibile: ${HELPER}"
	fi
	return 0
}

# -----------------------------------------------------------------------------
#  Main
# -----------------------------------------------------------------------------
main() {
	parse_args "$@"

	case "${COMMAND}" in
		apply)   cmd_apply ;;
		verify)  cmd_verify ;;
		show)    cmd_show ;;
		status)  cmd_status ;;
		policy)  cmd_apply "policy" ;;
		prefs)   cmd_apply "prefs" ;;
		icons)   cmd_apply "icons" ;;
		version) cmd_version ;;
		*)       usage >&2; exit 2 ;;
	esac
}

main "$@"
